{
  "name": "@agentsentinel/core",
  "version": "0.1.0",
  "description": "Universal zero-trust runtime security firewall and AST policy interceptor for AI agents, MCP servers, and autonomous tool execution.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "agentsentinel": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "presets",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "BENCHMARKS.md",
    "TROUBLESHOOTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack:dry-run": "npm pack --dry-run",
    "demo": "node scripts/demo.cjs"
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "security-firewall",
    "ast-interceptor",
    "prompt-injection",
    "zero-trust",
    "langchain",
    "vercel-ai"
  ],
  "author": {
    "name": "Mukesh Biswas (sparkysolutions10-pixel)",
    "orcid": "https://orcid.org/0009-0008-2818-6579"
  },
  "contributors": [
    {
      "name": "Mukesh Biswas",
      "orcid": "https://orcid.org/0009-0008-2818-6579"
    }
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.6.2",
    "vitest": "^2.1.8"
  }
}
